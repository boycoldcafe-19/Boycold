# Gmail SMTP Configuration for OTP emails
# IMPORTANT: Use an App Password, not your regular Gmail password
# To create an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Search for "App Passwords" and create one
# 4. Select "Mail" and "Other (Custom name)" -> enter "BoyCold"
# 5. Copy the 16-character password (remove spaces)
GMAIL_USERNAME=boycoldcafe19@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# SMTP Debug Level (0=off, 1=client messages, 2=client and server messages)
SMTP_DEBUG=0

# Google OAuth Configuration
# To get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Go to Credentials -> Create Credentials -> OAuth client ID
# 5. Select Web application
# 6. Add authorized redirect URI: http://localhost/boycoldv2/boycoldv2/google-login.php
# 7. Copy the Client ID and Client Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/boycoldv2/boycoldv2/google-login.php
